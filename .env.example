# ═══════════════════════════════════════════════════════════════
# oli-monitor — env vars
# Copie para .env e preencha os valores.
# ═══════════════════════════════════════════════════════════════

# Grafana
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=

# Loki basic auth (para Alloy remoto)
# Gere com: htpasswd -nB loki-agent
# Formato: user:hash (escape $ → $$ no compose)
LOKI_BASIC_AUTH_USERS=

# Versões (opcional)
# LOKI_VERSION=3.6.7
# GRAFANA_VERSION=12.4.0
# ALLOY_VERSION=v1.13.2
# ALERTS_VERSION=abcdef0

# Vigia dos patches de pré-aprovação (Supabase OPS, somente leitura)
# PATCH_WATCH_ENABLED=true
# PATCH_WATCH_POLL_SECONDS=30
# PATCH_WATCH_QUEUED_SECONDS=60
# PATCH_WATCH_FAILED_LOOKBACK_SECONDS=86400
# PATCH_WATCH_ALERT_COOLDOWN_SECONDS=21600
